# SimFarm Lab — All-in-One standalone image
# Single container running FastAPI backend, Ollama (CPU), and the Tier 4
# simulator. No Compose required after the image exists.
#
# Build:
#   docker build -f Dockerfile.all-in-one -t simfarm-lab .
#
# Run (first start may pull the Ollama model; persist it with a volume):
#   docker run -d -p 8000:8000 -v simfarm-ollama:/root/.ollama --name simfarm simfarm-lab
#
FROM ollama/ollama:0.6.7 AS ollama-bin

FROM python:3.11-slim

ARG VOICE_STACK=chatterbox
ARG VIDEO_STACK=
ARG FACE_STACK=
ARG COQUI_TOS_AGREED=

# Runtime deps + audio build deps for Chatterbox/Coqui TTS, Wan video, and InsightFace + supervisor for multi-process management
RUN apt-get update && apt-get install -y --no-install-recommends \
        curl ca-certificates supervisor build-essential git \
        libsndfile1 libsndfile1-dev ffmpeg \
        espeak espeak-data && \
    rm -rf /var/lib/apt/lists/*

# Copy Ollama binary and its runtime libraries from the official Ollama image
COPY --from=ollama-bin /bin/ollama /usr/local/bin/ollama
COPY --from=ollama-bin /usr/lib/ollama /usr/lib/ollama
ENV LD_LIBRARY_PATH=/usr/lib/ollama

WORKDIR /app

# Install Python dependencies first for layer caching; voice/video/face deps are heavy so keep them separate
COPY requirements.txt requirements-voice.txt requirements-voice-coqui.txt requirements-video-wan.txt requirements-face-insightface.txt ./
RUN pip install --no-cache-dir -r requirements.txt && \
    if [ "$VOICE_STACK" = "coqui" ]; then \
        pip install --no-cache-dir -r requirements-voice-coqui.txt; \
    else \
        pip install --no-cache-dir -r requirements-voice.txt; \
    fi && \
    if [ "$VIDEO_STACK" = "wan" ]; then \
        pip install --no-cache-dir -r requirements-video-wan.txt; \
    fi && \
    if [ "$FACE_STACK" = "insightface" ]; then \
        pip install --no-cache-dir --no-deps -r requirements-face-insightface.txt; \
    fi

# Pre-download InsightFace models into the image when the face stack is enabled.
ENV INSIGHTFACE_HOME=/opt/insightface
RUN if [ "$FACE_STACK" = "insightface" ]; then \
        python - <<'PY' \
import os, urllib.request \
import insightface \
from insightface.app import FaceAnalysis \
home = os.environ['INSIGHTFACE_HOME'] \
os.makedirs(home, exist_ok=True) \
app = FaceAnalysis(name='buffalo_l', root=home) \
app.prepare(ctx_id=0, det_size=(640,640)) \
model_path = os.path.join(home, 'models', 'inswapper_128.onnx') \
if not os.path.exists(model_path): \
    os.makedirs(os.path.dirname(model_path), exist_ok=True) \
    url = 'https://huggingface.co/ashleykleynhans/inswapper/resolve/main/inswapper_128.onnx' \
    urllib.request.urlretrieve(url, model_path) \
PY \
    fi

# Copy the entire application
COPY . .

# Make the entrypoint executable and place the supervisor config
RUN chmod +x /app/start-all-in-one.sh && \
    mkdir -p /etc/supervisor/conf.d && \
    cp /app/supervisord.conf /etc/supervisor/conf.d/supervisord.conf

# Runtime environment: all services live inside this container.
# OPENAI_API_KEY and any tokens should be passed at runtime with -e, not baked in.
ENV PYTHONUNBUFFERED=1 \
    OLLAMA_HOST=http://127.0.0.1:11434 \
    OLLAMA_MODEL=qwen2.5:1.5b \
    SIMFARM_SIM_URL=http://127.0.0.1:9000 \
    DEFAULT_FRAMEWORK=supervisor \
    ALLOW_ONLINE_TOOLS= \
    LEGAL_PROXY_ENABLED= \
    COQUI_TOS_AGREED=${COQUI_TOS_AGREED} \
    OPENAI_BASE_URL=https://api.openai.com/v1 \
    OPENAI_MODEL=gpt-4o-mini

EXPOSE 8000

CMD ["/usr/bin/supervisord", "-c", "/etc/supervisor/conf.d/supervisord.conf"]
