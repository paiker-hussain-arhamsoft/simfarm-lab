{
  "kind": "collectionType",
  "collectionName": "lifecycles",
  "info": {
    "singularName": "lifecycle",
    "pluralName": "lifecycles",
    "displayName": "Lifecycle",
    "description": "Content lifecycle entry for the simfarm-lab pipeline"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
