      "type": "string",
      "required": true
    },
    "body": {
      "type": "richtext"
    },
    "channel": {
      "type": "string"
    },
    "stage": {
      "type": "enumeration",
      "enum": ["draft", "review", "published"],
      "default": "draft"
    }
  }
}
